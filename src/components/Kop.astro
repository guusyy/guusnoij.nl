---
import { PERSOONLIJK, ZAKELIJK } from '../data/site';

interface Props {
  modus: 'licht' | 'donker';
  nav: { href: string; label: string }[];
  ondertitel?: string;
  taal: string;
}
const { modus, nav, ondertitel } = Astro.props;
const thuis = modus === 'licht' ? PERSOONLIJK : ZAKELIJK;
---
<header class="kop">
  <div class="wrap kop-in">
    <a class="merk" href={thuis} aria-label="Home">
      <span class="naam">Guus Noij<span class="punt">.</span></span>
      {ondertitel && <span class="onder">{ondertitel}</span>}
    </a>
    <nav aria-label="Menu">
      {nav.map((n) => <a href={n.href}>[ {n.label} ]</a>)}
      {modus === 'licht' && <button type="button" class="palet-knop" data-palet-open title="Search and secrets"><kbd>⌘K</kbd></button>}
    </nav>
    <slot name="wissel" />
  </div>
</header>

<style>
  .kop { padding: 2rem 0 0; }
  .kop-in { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'merk wissel' 'nav nav'; gap: 1.5rem 1rem; align-items: center; }
  .merk { grid-area: merk; text-decoration: none; color: var(--tekst); display: inline-flex; flex-direction: column; gap: .35rem; justify-self: start; }
  .naam { font: 700 1.6rem/1 var(--mono); letter-spacing: -.04em; white-space: nowrap; }
  .naam .punt { font-size: 1.15em; line-height: 0; }
  .onder { font: 400 .66rem/1 var(--mono); letter-spacing: .26em; color: var(--zacht); white-space: nowrap; }
  nav { grid-area: nav; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; font: 400 .85rem/1.8 var(--mono); text-transform: uppercase; }
  nav a { color: var(--tekst); text-decoration: none; white-space: nowrap; }
  nav a:hover { color: var(--blauw); }
  .palet-knop { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; color: var(--zacht); }
  .palet-knop kbd { font: .75rem/1 var(--mono); border: 1px solid var(--lijn); border-bottom-width: 2px; border-radius: .3rem; padding: .25rem .4rem; }
  .palet-knop:hover { color: var(--blauw); }
  /* Mobiel: menu op één regel die horizontaal scrolt; ⌘K alleen met een toetsenbord. */
  @media (max-width: 51.99rem) {
    .kop { padding-top: 1.25rem; }
    .naam { font-size: 1.35rem; }
    .onder { font-size: .56rem; letter-spacing: .16em; }
    .kop-in { grid-template-columns: minmax(0, 1fr) auto; }
    .kop-in { gap: 1rem; }
    nav { flex-wrap: nowrap; overflow-x: auto; gap: 1rem; margin: 0 -1.5rem; padding: 0 1.5rem .25rem; font-size: .78rem; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); }
    nav::-webkit-scrollbar { display: none; }
  }
  @media (hover: none) { .palet-knop { display: none; } }
  :global(.wissel) { grid-area: wissel; }
  @media (min-width: 52rem) {
    .kop-in { grid-template-columns: 1fr auto auto; grid-template-areas: 'merk nav wissel'; gap: 2rem; }
  }
</style>
