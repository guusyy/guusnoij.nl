---
import Basis from '../../layouts/Basis.astro';
import Voet from '../../components/Voet.astro';
import Kop from '../../components/zakelijk/Kop.astro';
import Cta from '../../components/zakelijk/Cta.astro';
import { navZakelijk, maak, beloftes } from '../../data/zakelijk';
---
<Basis modus="donker" taal="nl" ondertitel="DESIGN & DEVELOPMENT" nav={navZakelijk}
  titel="Diensten · Guus Noij Design & Development"
  omschrijving="Websites en webshops, maatwerk en webapps, dure softwarepakketten vervangen, automatisering met AI, design en huisstijl, hosting en beheer.">
  <Kop label="Diensten" titel="Wat ik maak" vt="diensten">
    <p class="intro">Van een nieuwe website tot een eigen systeem dat een duur pakket vervangt. Alles onder één dak, van idee tot beheer.</p>
  </Kop>

  <section>
    <div class="wrap">
      <div class="raster">
        {maak.map((m, i) => (
          <article id={String(i + 1)}>
            <span class="nr mono">{String(i + 1).padStart(2, '0')}</span>
            <h2>{m.titel}</h2>
            <p class="zacht">{m.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="kop2">Wat je van me kunt verwachten</h2>
      <dl class="beloftes">
        {beloftes.map((b) => (<div><dt>{b.titel}</dt><dd class="zacht">{b.tekst}</dd></div>))}
      </dl>
    </div>
  </section>

  <Cta />
  <Voet slot="voet" modus="donker" />
</Basis>

<style>
  .raster { display: grid; gap: 1px; background: var(--lijn); border: 1px solid var(--lijn); border-radius: .8rem; overflow: hidden; }
  @media (min-width: 40rem) { .raster { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 60rem) { .raster { grid-template-columns: repeat(3, 1fr); } }
  .raster article { padding: 1.75rem; background: var(--bg); transition: background .25s; scroll-margin-top: 2rem; }
  .raster article:hover, .raster article:target { background: var(--vlak); }
  .nr { font-size: .8rem; color: var(--blauw); }
  .raster h2 { font-size: 1.1rem; font-weight: 700; text-transform: none; letter-spacing: 0; margin: .8rem 0 .6rem; }
  .raster p { margin: 0; }
  .beloftes { display: grid; gap: 1rem; margin: 0; }
  @media (min-width: 48rem) { .beloftes { grid-template-columns: 1fr 1fr; } }
  .beloftes > div { padding: 1.4rem 1.5rem; border: 1px solid var(--lijn); border-radius: .8rem; background: var(--vlak); }
  .beloftes dt { font: 700 1rem/1.4 var(--mono); margin-bottom: .4rem; }
  .beloftes dt::before { content: '→ '; color: var(--blauw); }
  .beloftes dd { margin: 0; }
</style>
