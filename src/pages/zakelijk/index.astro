---
import Basis from '../../layouts/Basis.astro';
import Voet from '../../components/Voet.astro';
import Cta from '../../components/zakelijk/Cta.astro';
import { ZAKELIJK } from '../../data/site';
import { navZakelijk, herkenbaar, maak } from '../../data/zakelijk';
import { grafiek, bedrijf, websiteZakelijk } from '../../data/schema';
---
<Basis
  modus="donker" taal="nl" ondertitel="DESIGN & DEVELOPMENT" nav={navZakelijk}
  titel="Guus Noij Design & Development · websites en maatwerk"
  omschrijving="Websites, maatwerk, automatisering en hosting voor bedrijven. Van strategie en ontwerp tot ontwikkeling en beheer, met één vast aanspreekpunt in Gennep."
  schema={grafiek(bedrijf, websiteZakelijk)}
>
  <section class="held">
    <div class="wrap">
      <p class="prompt mono"><span class="punt">~/gennep</span> $ guus --help<span class="cursor" aria-hidden="true">▍</span></p>
      <h1>Digitale uitdagingen,<br class="br" /> simpel opgelost<span class="punt">.</span></h1>
      <p class="intro">
        Ik ben Guus. Ik help bedrijven van strategie en ontwerp tot ontwikkeling en beheer, met één vast aanspreekpunt.
        Met de nieuwste technieken maak ik precies wat jouw bedrijf nodig heeft.
      </p>
      <div class="knoppen">
        <a class="knop vol" href={`${ZAKELIJK}contact/`}>Vertel waar je tegenaan loopt →</a>
        <a class="knop" href={`${ZAKELIJK}diensten/`}>Wat ik maak</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap probleem">
      <div>
        <h2 class="kop2">Herkenbaar?</h2>
        <p class="groot">Precies daar help ik. Wat vroeger een groot en duur project was, kan nu vaak sneller en voordeliger, en precies op maat.</p>
      </div>
      <ul class="herkenbaar">{herkenbaar.map((h) => <li>{h}</li>)}</ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2 class="kop2">Wat ik maak</h2>
      <ul class="kort">
        {maak.map((m, i) => (
          <li><a href={`${ZAKELIJK}diensten/#${i + 1}`}><span class="nr mono">{String(i + 1).padStart(2, '0')}</span><span class="t">{m.titel}</span><span class="pijl">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Cta />
  <Voet slot="voet" modus="donker" />
</Basis>

<style>
  .held { padding-top: 6rem; }
  @media (max-width: 40rem) { .held { padding-top: 2.5rem; } .knoppen .knop { width: 100%; justify-content: center; } }
  .prompt { font-size: .9rem; color: var(--zacht); margin-bottom: 1.5rem; }
  .cursor { color: var(--blauw); margin-left: .15rem; animation: knipper 1.1s steps(1) infinite; }
  @keyframes knipper { 50% { opacity: 0; } }
  h1 { font-size: clamp(2.3rem, 6.5vw, 4.4rem); }
  @media (max-width: 40rem) { .br { display: none; } }
  .intro { font-size: 1.2rem; max-width: 40rem; margin-top: 1.75rem; }

  .probleem { display: grid; gap: 2rem; }
  @media (min-width: 52rem) { .probleem { grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: start; } }
  .herkenbaar { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
  .herkenbaar li { padding: 1.1rem 1.25rem 1.1rem 3rem; position: relative; border: 1px solid var(--lijn); border-radius: .7rem; background: var(--vlak); }
  .herkenbaar li::before { content: '?'; position: absolute; left: 1.15rem; top: 1.05rem; font: 700 1rem/1.6 var(--mono); color: var(--blauw); }

  .kort { list-style: none; padding: 0; margin: 0; display: grid; border-top: 1px solid var(--lijn); }
  @media (min-width: 48rem) { .kort { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  .kort a { display: flex; gap: 1rem; align-items: baseline; padding: 1.1rem 0; border-bottom: 1px solid var(--lijn); color: var(--tekst); text-decoration: none; font: 500 1.1rem/1.3 var(--mono); }
  .kort .nr { font-size: .8rem; color: var(--blauw); }
  .kort .t { flex: 1; }
  .kort .pijl { color: var(--zacht); transition: transform .2s, color .2s; }
  .kort a:hover .pijl { transform: translateX(4px); color: var(--blauw); }
</style>
