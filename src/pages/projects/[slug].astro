---
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import Voet from '../../components/Voet.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import { navPersoonlijk } from '../../data/persoonlijk';
import { getImage } from 'astro:assets';
import { projecten, type Project } from '../../data/projecten';
import { grafiek, kruimelpad } from '../../data/schema';
import { SITE_PERSOONLIJK } from '../../data/site';

export function getStaticPaths() {
  return projecten.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const i = projecten.indexOf(p);
const volgende = projecten[(i + 1) % projecten.length];
// Meta-beschrijving: eerste alinea (of de korte omschrijving), afgekapt op een heel woord rond 155 tekens.
const eerste = p.tekst?.[0]?.trim();
const vol = eerste && eerste.length <= 158 ? eerste : p.kort;
const beschrijving = vol.length <= 158 ? vol : vol.slice(0, vol.lastIndexOf(' ', 154)).replace(/[,:;]$/, '') + '…';
const og = await getImage({ src: p.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const schema = grafiek(
  {
    '@type': 'CreativeWork',
    name: p.naam,
    description: p.kort,
    url: `${SITE_PERSOONLIJK}/projects/${p.slug}/`,
    image: new URL(og.src, SITE_PERSOONLIJK).href,
    keywords: p.tags.join(', '),
    creator: { '@id': `${SITE_PERSOONLIJK}/#guus` },
    ...(p.links?.[0] ? { sameAs: p.links[0].url } : {}),
  },
  kruimelpad(SITE_PERSOONLIJK, [{ naam: 'Guus Noij', pad: '/' }, { naam: 'Projects', pad: '/#projects' }, { naam: p.naam, pad: `/projects/${p.slug}/` }]),
);
---
<Basis modus="licht" titel={`${p.naam} · Project by Guus Noij`} omschrijving={beschrijving} nav={navPersoonlijk} ogImage={og.src} ogType="article" {schema}>
  <PaginaKop icoon="🛠️" titel={p.naam} kruimels={[{ href: '/#projects', label: 'Projects' }]}>
    <p class="lead">{p.kort}</p>
  </PaginaKop>

  <section class="eerst">
    <div class="wrap">
      <Image class="cover" src={p.cover} alt={`Screenshot of ${p.naam}`} widths={[800, 1400]} sizes="(min-width: 68rem) 1088px, 100vw" style={`view-transition-name: cover-${p.slug}`} />
      <div class="twee">
        <dl class="feiten mono">
          {p.status && <><dt>Status</dt><dd>{p.status}</dd></>}
          {p.stack && <><dt>Stack</dt><dd>{p.stack}</dd></>}
          <dt>Tags</dt><dd>{p.tags.join(' · ')}</dd>
          {p.links?.length && <><dt>Links</dt><dd class="links">{p.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}</dd></>}
        </dl>
        <div class="tekst">{p.tekst?.map((t) => <p>{t}</p>)}</div>
      </div>
      {p.fotos && (
        <div class="fotos">
          {p.fotos.map((f) => <Image src={f} alt={`${p.naam} screenshot`} widths={[800, 1400]} sizes="(min-width: 68rem) 1088px, 100vw" />)}
        </div>
      )}
      <a class="volgende" href={`/projects/${volgende.slug}`}><span class="label">Next project</span><span class="mono">{volgende.naam} →</span></a>
    </div>
  </section>

  <Voet slot="voet" modus="licht" />
</Basis>

<style>
  .eerst { padding-top: 2.5rem; }
  .cover { width: 100%; height: auto; border-radius: .8rem; border: 1px solid var(--lijn); }
  .twee { display: grid; gap: 2rem; margin-top: 2.5rem; }
  @media (min-width: 52rem) { .twee { grid-template-columns: 18rem 1fr; gap: 3rem; } }
  .feiten { margin: 0; font-size: .85rem; display: grid; gap: .3rem; align-content: start; }
  .feiten dt { color: var(--zacht); text-transform: uppercase; letter-spacing: .1em; font-size: .7rem; margin-top: .8rem; }
  .feiten dt:first-child { margin-top: 0; }
  .feiten dd { margin: 0; }
  .links { display: grid; gap: .25rem; }
  .tekst { max-width: 40rem; font-size: 1.05rem; }
  .fotos { display: grid; gap: 1.25rem; margin-top: 3rem; }
  .fotos :global(img) { width: 100%; height: auto; border-radius: .8rem; border: 1px solid var(--lijn); }
  .volgende { display: flex; flex-direction: column; gap: .5rem; margin-top: 4rem; padding: 1.5rem; border: 1px solid var(--lijn); border-radius: .8rem; background: var(--vlak); color: var(--tekst); text-decoration: none; transition: border-color .2s; }
  .volgende:hover { border-color: var(--blauw); }
</style>
